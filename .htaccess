RewriteEngine On

# Home → portal (Hoje) em /
RewriteRule ^$ sistema/public/index.html [L]
RewriteRule ^portal\.html$ / [R=301,L]

# Auth / ranking / bot / live PHP (Hostinger sem Node)
RewriteRule ^api/(login|cadastro|logout|me)/?$ sistema/public/api/index.php [L,QSA]
RewriteRule ^api/senha/(esqueci|redefinir)/?$ sistema/public/api/index.php [L,QSA]
RewriteRule ^api/ranking/voto/?$ sistema/public/api/ranking.php [L,QSA]
RewriteRule ^api/ranking/?$ sistema/public/api/ranking.php [L,QSA]
RewriteRule ^api/chatbot/status/?$ sistema/public/api/chatbot.php [L,QSA]
RewriteRule ^api/chatbot/?$ sistema/public/api/chatbot.php [L,QSA]
RewriteRule ^api/proximo/?$ sistema/public/api/proximo.php [L,QSA]
RewriteRule ^api/(portal|hoje|agenda|tabela|tema|clubes|times|paises|busca|noticias|onboarding|jogo|coracao|avatares|resumo|feed|gnews)/?$ sistema/public/api/live.php [L,QSA]
RewriteRule ^api/social/(feed|post|seguir|curtir|comentar|perfil)/?$ sistema/public/api/social.php [L,QSA]

# Sempre preferir sistema/public (evita cópia antiga na raiz do repo)
RewriteCond %{DOCUMENT_ROOT}/sistema/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/sistema/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ sistema/public/$1 [L]

# JS/CSS: cache curto pra deploy no Hostinger não ficar com build velho
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
