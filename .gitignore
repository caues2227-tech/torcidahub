# Segredos: nunca versionar
.env
.env.*
!.env.example
sistema/.env
sistema/.env.*
!sistema/.env.example
sistema/data/.segredo
sistema/data/mail-outbox.json

# Dados gerados pelo servidor (banco, caches, uploads, backups)
sistema/data/
!sistema/data/.gitkeep

# Store PHP (usuarios/votos) — NUNCA versionar (deploy apagava o ranking)
sistema/public/api/_store/*.json
!sistema/public/api/_store/.htaccess
!sistema/public/api/_store/.gitkeep

# Pacotes de upload manual (não versionar)
PARA-SUBIR/
torcida-hostinger.zip
*.zip
temp/

# Dependências e sistema
node_modules/
*.log
.DS_Store
Thumbs.db
